rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per family. Its id is a long random "family code" that
    // works like a password, so listing is off and codes can't be discovered.
    match /families/{fam} {
      allow get: if fam.size() >= 20;
      allow list: if false;
      allow create, update: if fam.size() >= 20
        && request.resource.data.keys().hasOnly(['data', 'v', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow delete: if false;
    }
  }
}
